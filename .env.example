# Copy to .env for local use. On Railway set these as service Variables instead. Never commit .env.

MERIDIAN_ENV=development            # production on Railway (enforces a strong JWT_SECRET, secure cookies)
JWT_SECRET=replace-with-64-random-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
CIO_USERNAME=mason
CIO_PASSWORD=replace-with-a-long-password  # used once to create the CIO account on first boot

# simulated = clearly labelled demo data (default). coinbase = Coinbase public market data (no API keys needed or accepted).
MARKET_DATA_MODE=simulated
# Optional: pin exact Coinbase products if auto-discovery picks the wrong contract, e.g.
# MERIDIAN_PRODUCT_OVERRIDES={"GOLD":"GOL-26DEC26-CDE","OIL":"..."}
MERIDIAN_PRODUCT_OVERRIDES=
CANDLE_GRANULARITY=ONE_HOUR
STARTING_CAPITAL=700

RUN_WORKERS=true
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example/v1/traces   (requires pip install .[otel])

# Local-only (docker compose / bare metal). Railway injects DATABASE_URL and REDIS_URL from its plugins.
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0
